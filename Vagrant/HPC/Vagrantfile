Vagrant.configure("2") do |config|
  # ----------------------------------------
  # Global VirtualBox Provider Settings
  # ----------------------------------------
  config.vm.provider "virtualbox" do |vb|
    vb.memory = 2048
    vb.cpus   = 2
  end

  # ----------------------------------------
  # Rocky Linux Nodes (dual NIC + bridged)
  # ----------------------------------------
  {
    "rocky1" => { ip1: "192.168.56.11", ip2: "10.10.10.11", ip3: "192.168.1.111" },
    "rocky2" => { ip1: "192.168.56.12", ip2: "10.10.10.12", ip3: "192.168.1.112" },
    "rocky3" => { ip1: "192.168.56.13", ip2: "10.10.10.13", ip3: "192.168.1.113" }
  }.each do |name, cfg|
    config.vm.define name do |node|
      node.vm.box         = "generic/rocky9"
      node.vm.box_version = "4.3.12"
      node.vm.hostname    = name

      node.vm.network "private_network", ip: cfg[:ip1]
      node.vm.network "private_network", ip: cfg[:ip2], virtualbox__intnet: "pvt-net-10"

      node.vm.network "public_network",
        ip: cfg[:ip3],
        bridge: "en0: Wi-Fi (AirPort)"

      node.vm.provision "shell", path: "scripts/bootstrap-ssh.sh"
    end
  end

  # ----------------------------------------
  # Ubuntu Nodes (dual NIC + bridged)
  # ----------------------------------------
  {
    "ubuntu1" => { ip1: "192.168.56.21", ip2: "10.10.10.21", ip3: "192.168.1.121" },
    "ubuntu2" => { ip1: "192.168.56.22", ip2: "10.10.10.22", ip3: "192.168.1.122" }
  }.each do |name, cfg|
    config.vm.define name do |node|
      node.vm.box      = "ubuntu/jammy64"
      node.vm.hostname = name

      node.vm.network "private_network", ip: cfg[:ip1]
      node.vm.network "private_network", ip: cfg[:ip2], virtualbox__intnet: "pvt-net-10"

      node.vm.network "public_network",
        ip: cfg[:ip3],
        bridge: "en0: Wi-Fi (AirPort)"

      node.vm.provision "shell", path: "scripts/bootstrap-ssh.sh"
    end
  end

  # ----------------------------------------
  # Debian Node (dual NIC + bridged)
  # ----------------------------------------
  config.vm.define "debian1" do |node|
    node.vm.box      = "debian/bookworm64"
    node.vm.hostname = "debian1"

    node.vm.network "private_network", ip: "192.168.56.31"
    node.vm.network "private_network", ip: "10.10.10.31", virtualbox__intnet: "pvt-net-10"

    node.vm.network "public_network",
      ip: "192.168.1.131",
      bridge: "en0: Wi-Fi (AirPort)"

    node.vm.provision "shell", path: "scripts/bootstrap-ssh.sh"
  end
end
